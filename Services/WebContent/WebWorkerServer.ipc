#include <AK/JsonValue.h>
#include <LibIPC/File.h>
#include <LibIPC/TransportHandle.h>
#include <LibURL/URL.h>
#include <LibWebCommon/HTML/BroadcastChannelMessage.h>
#include <LibWebCommon/HTML/Scripting/SerializedEnvironmentSettingsObject.h>
#include <LibWebCommon/HTML/SerializationRecords.h>
#include <LibWebCommon/HTML/WorkerAgentForward.h>
#include <LibWebCommon/HTML/WorkerAgentTypes.h>
#include <LibWebCommon/HTML/WorkerTypes.h>
#include <LibWebCommon/Loader/NavigatorCompatibilityMode.h>
#include <LibWebCommon/Permissions/Permissions.h>
#include <LibWebCommon/ServiceWorker/ServiceWorkerTypes.h>

endpoint WebWorkerServer {
    connect_to_request_server(IPC::TransportHandle handle, int client_id, Optional<Utf16String> top_level_site) =|
    simulate_request_server_connection_loss_and_reconnect_for_testing(IPC::TransportHandle replacement_handle, int client_id, Optional<Utf16String> top_level_site) => ()
    set_site_compatibility_data(JsonValue data) =|
    set_permission_snapshot(Web::Permissions::PermissionSnapshot snapshot) =|
    set_user_agent(String user_agent) =|
    set_navigator_compatibility_mode(Web::NavigatorCompatibilityMode mode) =|
    set_preferred_languages(Vector<String> preferred_languages) =|

    start_worker(URL::URL url,
                 Web::HTML::WorkerType type,
                 Web::HTML::RequestCredentials credentials,
                 String name,
                 Web::HTML::TransferDataEncoder message_port,
                 Web::HTML::SerializedEnvironmentSettingsObject outside_settings,
                 Web::HTML::AgentType agent_type,
                 URL::Origin origin,
                 Web::HTML::EnvironmentId environment_id,
                 bool has_process_to_itself) =|

    start_service_worker(Web::ServiceWorker::ServiceWorkerStartRequest request) =|

    connect_shared_worker(Web::HTML::TransferDataEncoder message_port,
                          Web::HTML::SerializedEnvironmentSettingsObject outside_settings) =|

    close_worker() =|

    broadcast_channel_message(Web::HTML::BroadcastChannelMessage message) =|
    service_worker_job_settled(u64 request_id, Web::ServiceWorker::ServiceWorkerJobResult result) =|
    service_worker_registration_lookup_finished(u64 request_id, Vector<Web::ServiceWorker::ServiceWorkerRegistrationSnapshot> registrations) =|
    service_worker_registration_state_changed(u64 registration_id, Web::ServiceWorker::ServiceWorkerRegistrationSlot target, Optional<Web::ServiceWorker::ServiceWorkerDescriptor> source) =|
    service_worker_state_changed(Web::ServiceWorker::ServiceWorkerDescriptor worker) =|
    service_worker_update_found(u64 registration_id) =|
    service_worker_ready(u64 request_id, Web::ServiceWorker::ServiceWorkerRegistrationSnapshot registration) =|
    dispatch_service_worker_lifecycle_event(Web::ServiceWorker::ServiceWorkerLifecycleEvent event, u64 timeout_ms) =|
    service_worker_skip_waiting_finished(u64 request_id) =|
    dispatch_service_worker_message_event(Web::ServiceWorker::ServiceWorkerMessageSource source, URL::Origin origin, Web::HTML::SerializedTransferRecord message, u64 timeout_ms) =|
    service_worker_message_to_client(Web::HTML::EnvironmentId client_id, Web::ServiceWorker::ServiceWorkerDescriptor source, URL::Origin origin, Web::HTML::SerializedTransferRecord message) =|

    handle_file_return(i32 error, Optional<IPC::File> file, i32 request_id) =|
    blob_url_entry_removed(Utf16String url) =|
}
