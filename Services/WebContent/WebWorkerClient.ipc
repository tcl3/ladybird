#include <LibHTTP/Cookie/Cookie.h>
#include <LibHTTP/HSTS/ParsedHSTSPolicy.h>
#include <LibIPC/File.h>
#include <LibIPC/TransportHandle.h>
#include <LibURL/URL.h>
#include <LibWebCommon/FileAPI/SerializedBlobURLEntry.h>
#include <LibWebCommon/HTML/BroadcastChannelMessage.h>
#include <LibWebCommon/HTML/WorkerAgentForward.h>
#include <LibWebCommon/HTML/WorkerAgentTypes.h>
#include <LibWebCommon/HTML/SerializationRecords.h>
#include <LibWebCommon/Permissions/Permissions.h>
#include <LibWebCommon/ServiceWorker/ServiceWorkerTypes.h>

endpoint WebWorkerClient {
    did_add_blob_url_entry(Web::HTML::EnvironmentId environment_id, Utf16String url, Web::FileAPI::SerializedBlobURLEntry entry) => (URL::BlobURLEntry::Token token)
    did_remove_blob_url_entries(Web::HTML::EnvironmentId environment_id, Vector<Utf16String> urls) => ()
    did_request_blob_url_entry(Utf16String url, Optional<URL::BlobURLEntry::Token> token) => (Optional<Web::FileAPI::SerializedBlobURLEntry> entry)

    did_close_worker() =|
    did_close_shared_worker() => ()
    did_finish_loading_worker_script(bool worker_is_secure_context) =|
    did_fail_loading_worker_script() =|
    did_report_outside_settings_content_security_policy_violation(u64 policy_index, String effective_directive, URL::URL resource) =|
    did_request_cookie(URL::URL url, HTTP::Cookie::Source source) => (HTTP::Cookie::VersionedCookie cookie)
    did_request_file(ByteString path, i32 request_id) =|
    did_is_known_hsts_host(String domain) => (bool result)
    did_request_permission_snapshot(URL::Origin top_level_origin) => (Web::Permissions::PermissionSnapshot snapshot)
    request_media_server_connection() => (Optional<IPC::TransportHandle> handle)
    request_image_decoder_connection() => (Optional<IPC::TransportHandle> handle)
    request_compositor_connection() => (Optional<IPC::TransportHandle> handle)
    did_release_image_decoder() =|
    did_post_broadcast_channel_message(Web::HTML::PostedBroadcastChannelMessage message) =|
    register_dedicated_worker(Web::HTML::WorkerAgentStartRequest request, IPC::TransportHandle worker_transport) =|
    did_schedule_service_worker_job(Web::ServiceWorker::ServiceWorkerJobRequest request) =|
    did_request_service_worker_registration(Web::HTML::EnvironmentId environment_id, u64 request_id, URL::URL client_url) =|
    did_request_service_worker_registrations(Web::HTML::EnvironmentId environment_id, u64 request_id) =|
    did_request_service_worker_ready(Web::HTML::EnvironmentId environment_id, u64 request_id, URL::URL creation_url) =|
    did_fetch_service_worker_script(Web::ServiceWorker::ServiceWorkerScriptFetchResult result) =|
    did_run_service_worker(bool succeeded, Vector<String> event_types_to_handle) =|
    did_finish_service_worker_lifecycle_event(Web::ServiceWorker::ServiceWorkerLifecycleEvent event, bool succeeded) =|
    did_call_service_worker_skip_waiting(u64 request_id) =|
    did_post_message_to_service_worker(Web::ServiceWorker::ServiceWorkerClientSnapshot source, u64 service_worker_id, Web::HTML::SerializedTransferRecord message) =|
    did_post_message_to_service_worker_client(String client_id, Web::HTML::SerializedTransferRecord message) =|
    did_change_service_worker_pending_events(bool has_pending_events) =|
    did_record_service_worker_scripts(Vector<Web::ServiceWorker::ServiceWorkerScriptResource> scripts) =|
    did_respond_to_service_worker_heartbeat(u64 heartbeat_id) =|
    did_request_navigation_preload(Web::HTML::EnvironmentId environment_id, u64 request_id, u64 registration_id, Web::ServiceWorker::ServiceWorkerNavigationPreloadOperation operation, ByteString header_value) =|
    did_request_service_worker_clients(u64 request_id, String client_id, bool is_get, bool include_uncontrolled, Web::Bindings::ClientType type) =|
    did_provide_service_worker_client_snapshots(u64 gather_id, Vector<Web::ServiceWorker::ServiceWorkerClientSnapshot> snapshots) =|
}
