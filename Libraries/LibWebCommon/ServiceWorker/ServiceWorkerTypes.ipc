// NB: The IPC compiler cannot check that each struct here lists every field of its C++ type. A field left out
//     here does not cross IPC.

#include <LibWebCommon/ServiceWorker/ServiceWorkerTypes.h>

// NB: Each enum here is refused over IPC when a peer sends a value it does not declare. The binding enums are generated
//     from IDL into headers that cannot include these codecs, so a message that sends one of them must include
//     ServiceWorkerTypes.h for the value to be checked. Only the service worker types send them today.

[ExistingCpp]
enum Web::Bindings::ClientType : u8 {
    Window,
    Worker,
    Sharedworker,
    All,
}

[ExistingCpp]
enum Web::Bindings::FrameType : u8 {
    Auxiliary,
    TopLevel,
    Nested,
    None,
}

[ExistingCpp]
enum Web::Bindings::DocumentVisibilityState : u8 {
    Visible,
    Hidden,
}

[ExistingCpp]
enum Web::Bindings::ServiceWorkerState : u8 {
    Parsed,
    Installing,
    Installed,
    Activating,
    Activated,
    Redundant,
}

[ExistingCpp]
enum Web::Bindings::ServiceWorkerUpdateViaCache : u8 {
    Imports,
    All,
    None,
}

[ExistingCpp]
enum Web::ServiceWorker::ServiceWorkerJobType : u8 {
    Register,
    Update,
    Unregister,
}

[ExistingCpp]
enum Web::ServiceWorker::ServiceWorkerJobError : u8 {
    TypeError,
    SecurityError,
}

[ExistingCpp]
enum Web::ServiceWorker::ServiceWorkerRegistrationSlot : u8 {
    Installing,
    Waiting,
    Active,
}

[ExistingCpp]
enum Web::ServiceWorker::ServiceWorkerLifecycleEvent : u8 {
    Install,
    Activate,
}

[ExistingCpp]
enum Web::ServiceWorker::ServiceWorkerNavigationPreloadOperation : u8 {
    Enable,
    Disable,
    SetHeaderValue,
    GetState,
}

[ExistingCpp]
struct Web::ServiceWorker::ServiceWorkerDescriptor {
    u64 id;
    URL::URL script_url;
    Web::ServiceWorker::ServiceWorkerState state;
}

[ExistingCpp]
struct Web::ServiceWorker::ServiceWorkerClientSnapshot {
    Web::HTML::EnvironmentId id;
    URL::URL url;
    Web::Bindings::ClientType type;
    Web::Bindings::FrameType frame_type;
    Web::Bindings::DocumentVisibilityState visibility_state;
    bool focused;
    Vector<String> ancestor_origins;
}

[ExistingCpp]
struct Web::ServiceWorker::ServiceWorkerRegistrationSnapshot {
    u64 id;
    URL::URL scope_url;
    Web::ServiceWorker::ServiceWorkerUpdateViaCache update_via_cache;
    Optional<Web::ServiceWorker::ServiceWorkerDescriptor> installing_worker;
    Optional<Web::ServiceWorker::ServiceWorkerDescriptor> waiting_worker;
    Optional<Web::ServiceWorker::ServiceWorkerDescriptor> active_worker;
}

[ExistingCpp]
struct Web::ServiceWorker::ServiceWorkerJobRequest {
    u64 request_id;
    Web::ServiceWorker::ServiceWorkerJobType job_type;
    Web::HTML::SerializedEnvironmentSettingsObject client;
    URL::URL scope_url;
    Optional<URL::URL> script_url;
    Web::HTML::WorkerType worker_type;
    Web::ServiceWorker::ServiceWorkerUpdateViaCache update_via_cache;
    bool client_has_dispatched_dom_content_loaded;
}

[ExistingCpp]
struct Web::ServiceWorker::ServiceWorkerReservedClient {
    Web::HTML::EnvironmentId id;
    URL::URL creation_url;
    URL::URL url;
    Optional<Web::HTML::CrossProcessId> navigable_id;
}

[ExistingCpp]
struct Web::ServiceWorker::ServiceWorkerControllerMatch {
    Web::ServiceWorker::ServiceWorkerDescriptor active_worker;
    Web::ServiceWorker::ServiceWorkerRegistrationSnapshot registration;
    bool handles_fetch_events;
    bool navigation_preload_enabled;
    ByteString navigation_preload_header_value;
}

[ExistingCpp]
struct Web::ServiceWorker::ServiceWorkerScriptFetchParameters {
    Web::HTML::SerializedEnvironmentSettingsObject job_client;
    bool force_bypass_cache;
}

[ExistingCpp]
struct Web::ServiceWorker::ServiceWorkerNavigationPreloadState {
    bool enabled;
    ByteString header_value;
}

[ExistingCpp]
struct Web::ServiceWorker::ServiceWorkerScriptResource {
    URL::URL url;
    u16 status;
    Vector<HTTP::Header> header_list;
    ByteBuffer body;
}

[ExistingCpp]
struct Web::ServiceWorker::ServiceWorkerStartRequest {
    Web::ServiceWorker::ServiceWorkerDescriptor worker;
    Web::HTML::WorkerType worker_type;
    Web::ServiceWorker::ServiceWorkerRegistrationSnapshot registration;
    Web::HTML::EnvironmentId environment_id;
    URL::Origin origin;
    bool has_cross_site_ancestor;
    Optional<URL::Origin> top_level_origin;
    Web::ServiceWorker::ServiceWorkerScriptFetchParameters script_fetch;
    Vector<Web::ServiceWorker::ServiceWorkerScriptResource> stored_scripts;
    u64 extendable_event_timeout_ms;
    Optional<URL::URL> newest_worker_script_url;
    Web::HTML::WorkerType newest_worker_type;
    Vector<Web::ServiceWorker::ServiceWorkerScriptResource> newest_worker_scripts;
    bool registration_is_stale;
}
