// https://w3c.github.io/ServiceWorker/#client-interface
[Exposed=ServiceWorker, ImplementedIn=Rust]
interface Client {
    readonly attribute USVString url;
    readonly attribute FrameType frameType;
    readonly attribute DOMString id;
    readonly attribute ClientType type;
    [ImplementedAs=post_message] undefined postMessage(any message, sequence<object> transfer);
    [ImplementedAs=post_message_with_options] undefined postMessage(any message, optional StructuredSerializeOptions options = {});
};

enum FrameType {
    "auxiliary",
    "top-level",
    "nested",
    "none"
};
