#include <LibWeb/ServiceWorker/FetchEventTypes.h>

// The messages that a service worker client's process gets from the process of its active service worker.
endpoint ServiceWorkerFetchClient {
    fetch_event_settled(u64 fetch_id, Web::ServiceWorker::FetchEventOutcome outcome, Optional<Web::ServiceWorker::FetchEventResponse> response) =|
    fetch_response_body_data(u64 fetch_id, ByteBuffer data) =|
    fetch_response_body_end(u64 fetch_id, bool succeeded) =|
}
